{
  "name": "koma-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Koma Studio - AI Drama Creation Tool",
  "main": "./public/electron/main.js",
  "scripts": {
    "postinstall": "npx @electron/rebuild -f -w better-sqlite3",
    "dev": "ee-bin dev",
    "start": "ee-bin start",
    "dev-frontend": "ee-bin dev --serve=frontend",
    "dev-electron": "ee-bin dev --serve=electron",
    "build": "npm run build-frontend && npm run build-electron",
    "build-frontend": "ee-bin build --cmds=frontend && ee-bin move --flag=frontend_dist",
    "build-electron": "ee-bin build --cmds=electron",
    "encrypt": "ee-bin encrypt",
    "build-w": "ee-bin build --cmds=win64",
    "build-m": "ee-bin build --cmds=mac",
    "build-m-arm64": "ee-bin build --cmds=mac_arm64",
    "build-l": "ee-bin build --cmds=linux",
    "re-sqlite": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.12",
    "@langchain/core": "^1.1.17",
    "@langchain/google-genai": "^2.1.13",
    "@langchain/langgraph": "^1.1.2",
    "@langchain/openai": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.6.2",
    "ee-core": "^4.1.5",
    "electron-store": "^11.0.2",
    "extract-zip": "^2.0.1",
    "langchain": "^1.2.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "ee-bin": "^4.2.0",
    "electron": "^39.6.1",
    "electron-builder": "^26.4.0",
    "typescript": "~5.8.2"
  }
}
