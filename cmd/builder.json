{
  "productName": "Koma Studio",
  "appId": "com.koma.studio",
  "copyright": "© 2026 Koma Studio",
  "directories": {
    "output": "out"
  },
  "asar": true,
  "files": [
    "**/*",
    "!cmd/",
    "!electron/",
    "!frontend/",
    "!logs/",
    "!out/",
    "!packages/",
    "!openspec/"
  ],
  "extraResources": {
    "from": "build/extraResources/",
    "to": "extraResources"
  },
  "nsis": {
    "oneClick": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Koma Studio"
  },
  "publish": [
    {
      "provider": "generic",
      "url": ""
    }
  ],
  "win": {
    "artifactName": "${productName}-${os}-${version}-${arch}.${ext}",
    "target": [
      {
        "target": "nsis"
      }
    ]
  }
}
