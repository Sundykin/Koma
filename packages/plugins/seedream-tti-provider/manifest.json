{
  "id": "com.koma.seedream-tti-provider",
  "name": "Seedream 文生图服务",
  "version": "1.0.0",
  "description": "豆包 Seedream 4.0 文生图/图生图服务 (doubao-seedream-4-0-250828)",
  "author": {
    "name": "Koma Team",
    "url": "https://github.com/koma-studio"
  },
  "category": "provider",
  "engine": {
    "minAppVersion": "2.5.0",
    "sdkVersion": "1.0.0"
  },

  "permissions": [
    { "id": "config.read", "reason": "读取 API 配置" },
    { "id": "config.write", "reason": "保存 API 配置" },
    { "id": "net.fetch", "reason": "调用 Seedream API" },
    { "id": "capability.register", "reason": "注册 TTI 能力点" }
  ],

  "capabilities": [
    {
      "kind": "tti",
      "name": "seedream-tti",
      "version": "1.0.0",
      "config": {
        "displayName": "Seedream 4.0",
        "features": ["img2img"]
      }
    }
  ],

  "entry": {
    "frontend": "./dist/ui/main.js",
    "backend": "./dist/backend.js"
  },

  "providerMeta": {
    "channelType": "tti",
    "capabilities": ["tti"],
    "configPanel": true,
    "defaultConfig": {
      "apiKey": "",
      "baseUrl": "https://api.vectorengine.ai",
      "sizePreset": "2K",
      "watermark": true
    }
  }
}
