{
  "id": "com.koma.scdn-image-hosting",
  "name": "SCDN 图床服务",
  "version": "1.0.0",
  "description": "SCDN 图床服务，支持图片上传并获取远程 URL，用于 AI 图像生成和视频生成",
  "author": {
    "name": "Koma Team",
    "url": "https://github.com/koma-studio"
  },
  "category": "provider",
  "engine": {
    "minAppVersion": "2.5.0",
    "sdkVersion": "1.0.0"
  },

  "permissions": [
    { "id": "config.read", "reason": "读取 API 配置" },
    { "id": "config.write", "reason": "保存 API 配置" },
    { "id": "net.fetch", "reason": "上传图片到 SCDN" },
    { "id": "capability.register", "reason": "注册图床能力点" }
  ],

  "capabilities": [
    {
      "kind": "image-hosting",
      "name": "scdn-image-hosting",
      "version": "1.0.0",
      "config": {
        "displayName": "SCDN 图床"
      }
    }
  ],

  "entry": {
    "frontend": "./dist/ui/main.js",
    "backend": "./dist/backend.js"
  },

  "providerMeta": {
    "channelType": "image-hosting",
    "capabilities": ["image-hosting"],
    "configPanel": true,
    "defaultConfig": {
      "enabled": false,
      "apiEndpoint": "https://img.scdn.io/api/v1.php",
      "outputFormat": "webp",
      "cdnDomain": ""
    }
  }
}
