{
  "id": "com.koma.scdn-image-hosting",
  "name": "SCDN 图床服务",
  "version": "1.0.0",
  "description": "SCDN 图床服务，支持图片上传并获取远程 URL，用于 AI 图像生成和视频生成",
  "author": {
    "name": "Koma Team",
    "url": "https://github.com/koma-studio"
  },
  "category": "provider",
  "engine": {
    "minAppVersion": "2.5.0",
    "sdkVersion": "1.0.0"
  },
  "scopes": [
    "settings:read",
    "settings:write",
    "storage:limited",
    "network:external"
  ],
  "entry": {
    "frontend": "./dist/ui/main.js",
    "backend": "./dist/backend.js"
  },
  "providerMeta": {
    "channelType": "image-hosting",
    "capabilities": ["image-hosting"],
    "configPanel": true,
    "defaultConfig": {
      "enabled": false,
      "apiEndpoint": "https://img.scdn.io/api/v1.php",
      "outputFormat": "webp",
      "cdnDomain": ""
    }
  }
}
