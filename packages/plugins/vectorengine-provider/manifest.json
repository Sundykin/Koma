{
  "id": "com.koma.vectorengine-provider",
  "name": "VectorEngine 视频服务",
  "version": "1.0.0",
  "description": "VectorEngine.ai 视频生成服务提供者 - 支持 Sora-2 图生视频和角色提取",
  "author": {
    "name": "Koma Team",
    "url": "https://github.com/koma-studio"
  },

  "category": "provider",
  "engine": {
    "minAppVersion": "2.5.0",
    "sdkVersion": "1.0.0"
  },

  "scopes": [
    "settings:read",
    "settings:write",
    "storage:limited",
    "network:external"
  ],

  "entry": {
    "frontend": "./dist/ui/main.js",
    "backend": "./dist/backend.js"
  },

  "providerMeta": {
    "channelType": "itv",
    "displayName": "VectorEngine (Sora-2)",
    "capabilities": ["itv", "character-extract"],
    "configPanel": true,
    "defaultConfig": {
      "baseUrl": "https://api.vectorengine.ai",
      "models": ["sora-2-all", "sora-2"],
      "defaultModel": "sora-2-all",
      "orientations": ["portrait", "landscape"],
      "sizes": ["small", "large"],
      "durations": [10, 15, 20]
    }
  }
}
