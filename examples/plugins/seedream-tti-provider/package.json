{
  "name": "koma-plugin-seedream-tti-provider",
  "version": "1.0.0",
  "description": "Koma Plugin - Seedream TTI Provider (doubao-seedream-4-0)",
  "main": "dist/main.js",
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --format=iife --global-name=__KOMA_PLUGIN_com_koma_seedream_tti_provider__ --outfile=dist/ui/main.js --external:react --external:antd",
    "build:watch": "esbuild src/index.tsx --bundle --format=iife --global-name=__KOMA_PLUGIN_com_koma_seedream_tti_provider__ --outfile=dist/ui/main.js --external:react --external:antd --watch",
    "zip": "cd .. && powershell Compress-Archive -Path seedream-tti-provider/manifest.json,seedream-tti-provider/dist,seedream-tti-provider/README.md -DestinationPath seedream-tti-provider.zip -Force"
  },
  "peerDependencies": {
    "antd": "^5.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@komastudio/plugin-sdk": "^1.0.3",
    "esbuild": "^0.19.12",
    "typescript": "^5.9.3"
  }
}
